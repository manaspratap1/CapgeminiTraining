<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Book Bean -->
    <bean id="book1" class="dependency_injection.Book">
        <property name="book_id" value="1"/>
        <property name="bookName" value="Wings of Fire"/>
    </bean>

    <!-- Library Bean with Dependency Injection -->
    <bean id="library" class="dependency_injection.Library">
        <property name="id" value="101"/>
        <property name="name" value="Central Library"/>
        <property name="book" ref="book1"/>
    </bean>

</beans>
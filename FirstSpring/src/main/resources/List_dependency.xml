<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="B1" class="dependency_injection.Book">
        <property name="book_id" value="1"/>
        <property name="bookName" value="Wings of Fire"/>
    </bean>

    <bean id="B2" class="dependency_injection.Book">
        <property name="book_id" value="2"/>
        <property name="bookName" value="Atomic Habits"/>
    </bean>

    <bean id="B3" class="dependency_injection.Book">
        <property name="book_id" value="3"/>
        <property name="bookName" value="Rich Dad Poor Dad"/>
    </bean>

</beans>
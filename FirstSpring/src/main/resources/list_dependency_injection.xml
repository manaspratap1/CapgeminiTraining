<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Book Beans -->
    <bean id="book1" class="dependency_injection.Book">
        <property name="book_id" value="1"/>
        <property name="bookName" value="Wings of Fire"/>
    </bean>

    <bean id="book2" class="dependency_injection.Book">
        <property name="book_id" value="2"/>
        <property name="bookName" value="Atomic Habits"/>
    </bean>

    <bean id="book3" class="dependency_injection.Book">
        <property name="book_id" value="3"/>
        <property name="bookName" value="Rich Dad Poor Dad"/>
    </bean>

    <!-- Library Bean -->
    <bean id="library1" class="dependency_injection.Library1">
        <property name="id" value="101"/>
        <property name="name" value="Central Library"/>

        <property name="books">
            <list>
                <ref bean="book1"/>
                <ref bean="book2"/>
                <ref bean="book3"/>
            </list>
        </property>
    </bean>

</beans>